# APMTRACK API — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs

APP_ENV=development
APP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://apmtrack:votre_mot_de_passe@localhost:5432/apmtrack
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
# DATABASE_IDLE_TIMEOUT_SECONDS=300

# JWT — minimum 32 caractères OBLIGATOIRE
JWT_SECRET=changez_moi_absolument_minimum_32_chars_!!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Migrations automatiques au démarrage
RUN_MIGRATIONS_ON_STARTUP=true

# CORS — origines autorisées (virgule-séparées)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL publique de l'API (pour les QR codes)
PUBLIC_API_URL=http://localhost:8080

# URL publique du front (portail citoyen) — pour les liens de suivi WhatsApp.
# Optionnel : par défaut = PUBLIC_API_URL.
# PUBLIC_WEB_URL=http://localhost:4200

# Rate limiting backend mono-instance
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PUBLIC_MAX=60

# Object storage (MinIO/S3) — photos preuve des PV.
# Optionnel : si absent, les endpoints photos renvoient "stockage non configure".
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apmtrack-pv-photos
S3_ACCESS_KEY=apmtrack
S3_SECRET_KEY=apmtrack_dev_password

# SMTP — rapports quotidiens automatisés au Maire.
# Optionnel : si SMTP_HOST/SMTP_FROM absents, l'envoi d'e-mails est désactivé.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_FROM=no-reply@g-apm.cm
# SMTP_USERNAME=
# SMTP_PASSWORD=
# Rapport quotidien : activer + heure d'envoi (UTC, 0–23).
DAILY_REPORT_ENABLED=false
DAILY_REPORT_HOUR_UTC=5

# WhatsApp (Meta Cloud API) — notification du numéro de suivi au plaignant.
# Optionnel : si PHONE_NUMBER_ID/ACCESS_TOKEN absents, l'envoi est désactivé.
# WHATSAPP_API_BASE_URL=https://graph.facebook.com/v21.0
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=

# Optionnel — seed du super-admin au premier démarrage
# SEED_SUPER_ADMIN_EMAIL=admin@votre-commune.cm
# SEED_SUPER_ADMIN_PASSWORD=mot_de_passe_tres_fort_12_chars_min
# SEED_SUPER_ADMIN_FULL_NAME=Administrateur Principal
