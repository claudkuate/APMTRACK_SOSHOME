# APMTRACK API — Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs

APP_ENV=development
APP_PORT=8080

# PostgreSQL
DATABASE_URL=postgres://apmtrack:votre_mot_de_passe@localhost:5432/apmtrack
DATABASE_MAX_CONNECTIONS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=3
# DATABASE_IDLE_TIMEOUT_SECONDS=300

# JWT — minimum 32 caractères OBLIGATOIRE
JWT_SECRET=changez_moi_absolument_minimum_32_chars_!!
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=7

# Migrations automatiques au démarrage
RUN_MIGRATIONS_ON_STARTUP=true

# CORS — origines autorisées (virgule-séparées)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# URL publique de l'API (pour les QR codes)
PUBLIC_API_URL=http://localhost:8080

# Rate limiting backend mono-instance
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_PUBLIC_MAX=60

# Object storage (MinIO/S3) — photos preuve des PV.
# Optionnel : si absent, les endpoints photos renvoient "stockage non configure".
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=apmtrack-pv-photos
S3_ACCESS_KEY=apmtrack
S3_SECRET_KEY=apmtrack_dev_password

# Optionnel — seed du super-admin au premier démarrage
# SEED_SUPER_ADMIN_EMAIL=admin@votre-commune.cm
# SEED_SUPER_ADMIN_PASSWORD=mot_de_passe_tres_fort_12_chars_min
# SEED_SUPER_ADMIN_FULL_NAME=Administrateur Principal
