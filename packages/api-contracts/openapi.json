{
  "openapi": "3.1.0",
  "info": {
    "title": "APMTRACK API",
    "version": "0.1.0",
    "description": "Contrat OpenAPI Phase 1 - backend fondation: sante, auth, RBAC, communes, utilisateurs, agents et audit."
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Developpement local"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "security": [],
        "summary": "Verifie que l'API est disponible",
        "responses": {
          "200": {
            "description": "API disponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "security": [],
        "summary": "Verifie la connectivite PostgreSQL",
        "responses": {
          "200": {
            "description": "Base de donnees joignable"
          },
          "503": {
            "description": "Base de donnees indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/": {
      "get": {
        "security": [],
        "summary": "Racine de l'API v1",
        "responses": {
          "200": {
            "description": "API v1 disponible"
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "security": [],
        "summary": "Connecte un utilisateur actif",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tokens emis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "security": [],
        "summary": "Rafraichit une session par refresh token rotatif",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nouveaux tokens emis",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "summary": "Revoque un refresh token ou toutes les sessions de l'utilisateur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LogoutRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Session revoquee"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Retourne le profil authentifie",
        "responses": {
          "200": {
            "description": "Profil utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "summary": "Liste les utilisateurs selon le role et la commune",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPage"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "Cree un utilisateur et assigne ses roles",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Utilisateur cree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "patch": {
        "summary": "Modifie un utilisateur",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Utilisateur modifie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/v1/communes": {
      "get": {
        "summary": "Liste les communes visibles par l'utilisateur",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommunePage"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Cree une commune",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommuneRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commune creee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commune"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/v1/communes/{id}": {
      "patch": {
        "summary": "Modifie une commune",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchCommuneRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Commune modifiee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Commune"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents": {
      "get": {
        "summary": "Liste les agents selon le role et la commune",
        "parameters": [
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Liste paginee",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentPage"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Cree un agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent cree",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}": {
      "patch": {
        "summary": "Modifie un agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Agent modifie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}/suspend": {
      "post": {
        "summary": "Suspend un agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Agent suspendu",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}/reactivate": {
      "post": {
        "summary": "Reactive un agent",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Agent reactive",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/agents/{id}/retire": {
      "post": {
        "summary": "Passe un agent au statut retraite",
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "responses": {
          "200": {
            "description": "Agent retraite",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Agent"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/public/agents/verify/{matricule}": {
      "get": {
        "security": [],
        "summary": "Verifie publiquement un agent par matricule",
        "parameters": [
          {
            "name": "matricule",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent trouve",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicAgentVerification"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "Id": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      "PageSize": {
        "name": "page_size",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentification invalide",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Role ou commune non autorise",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource introuvable",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      },
      "Conflict": {
        "description": "Contrainte d'unicite violee",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "RoleCode": {
        "type": "string",
        "enum": [
          "SUPER_ADMIN",
          "ADMIN_COMMUNE",
          "APM_AGENT",
          "SUPERVISEUR",
          "RECEVEUR"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status",
          "service",
          "environment",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "apmtrack-api"
          },
          "environment": {
            "type": "string",
            "example": "development"
          },
          "version": {
            "type": "string",
            "example": "0.1.0"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "details"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            }
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        }
      },
      "RefreshRequest": {
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        }
      },
      "LogoutRequest": {
        "type": "object",
        "properties": {
          "refresh_token": {
            "type": "string"
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "refresh_token",
          "token_type",
          "expires_in_seconds",
          "user"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "refresh_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in_seconds": {
            "type": "integer"
          },
          "user": {
            "$ref": "#/components/schemas/MeResponse"
          }
        }
      },
      "MeResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          }
        ]
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "commune_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleCode"
            }
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "required": [
          "email",
          "password",
          "full_name",
          "roles"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "commune_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleCode"
            }
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "PatchUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "commune_id": {
            "type": "string",
            "format": "uuid"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleCode"
            }
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "UserPage": {
        "$ref": "#/components/schemas/PaginatedUsers"
      },
      "Commune": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "departement": {
            "type": "string"
          },
          "adresse": {
            "type": [
              "string",
              "null"
            ]
          },
          "telephone": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "site_web": {
            "type": [
              "string",
              "null"
            ]
          },
          "logo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "theme_color": {
            "type": [
              "string",
              "null"
            ]
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateCommuneRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PatchCommuneRequest"
          }
        ],
        "required": [
          "code",
          "nom",
          "region",
          "departement"
        ]
      },
      "PatchCommuneRequest": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "nom": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "departement": {
            "type": "string"
          },
          "adresse": {
            "type": "string"
          },
          "telephone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "site_web": {
            "type": "string"
          },
          "logo_url": {
            "type": "string"
          },
          "theme_color": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "CommunePage": {
        "$ref": "#/components/schemas/PaginatedCommunes"
      },
      "Agent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "matricule": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "commune_id": {
            "type": "string",
            "format": "uuid"
          },
          "grade": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIF",
              "SUSPENDU",
              "RETRAITE",
              "INACTIF"
            ]
          },
          "date_prise_fonction": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "formation_nasla": {
            "type": "boolean"
          },
          "photo_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "telephone": {
            "type": [
              "string",
              "null"
            ]
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateAgentRequest": {
        "type": "object",
        "required": [
          "matricule",
          "full_name",
          "commune_id",
          "grade"
        ],
        "properties": {
          "matricule": {
            "type": "string"
          },
          "full_name": {
            "type": "string"
          },
          "commune_id": {
            "type": "string",
            "format": "uuid"
          },
          "grade": {
            "type": "string"
          },
          "date_prise_fonction": {
            "type": "string",
            "format": "date"
          },
          "formation_nasla": {
            "type": "boolean"
          },
          "photo_url": {
            "type": "string"
          },
          "telephone": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PatchAgentRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/CreateAgentRequest"
          }
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "AgentPage": {
        "$ref": "#/components/schemas/PaginatedAgents"
      },
